{
  "name": "@ca-career-os/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsc && node --watch dist/main.js",
    "watch": "tsc -w --preserveWatchOutput",
    "prebuild": "pnpm --filter @ca-career-os/shared build && prisma generate",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/**/*.test.mjs",
    "test:db": "node test/postgres-persistence.integration.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@ca-career-os/shared": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.4.0",
    "dotenv": "^16.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "prisma": "^6.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
