# CA Career OS — Environment Configuration Template
# NOTE: Safe defaults and placeholders for local development only.
# NEVER commit real credentials, production secrets, or private keys.

# Environment Mode: development | test | staging | production
NODE_ENV=development

# Backend API Configuration
PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Structured Logging & Observability Configuration
# LOG_LEVEL: debug | info | warn | error | fatal (defaults to 'info' in production, 'debug' in development)
LOG_LEVEL="info"
# LOG_FORMAT: json | pretty (defaults to 'json' in production, 'pretty' in development)
LOG_FORMAT="json"

# Frontend Web Application Configuration
WEB_PORT=3000
# Railway API origin for Vercel reverse proxy (e.g. https://your-api.up.railway.app without /api/v1 suffix)
API_ORIGIN="http://localhost:4000"

# PostgreSQL Database Configuration
# DATABASE_URL: Pooled connection string for serverless runtime queries (e.g., Neon connection pooler / Supabase Supavisor port 6543)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public&pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ca_career_os?schema=public"
# DIRECT_URL: Direct unpooled connection string for executing Prisma schema migrations (e.g., direct port 5432)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ca_career_os?schema=public"

# Redis Queue & Cache (BullMQ)
REDIS_URL="redis://localhost:6379"

# Security & Authentication (Tokens)
# Minimum 32 characters for HMAC SHA-256 signing
JWT_SECRET="ca-career-os-dev-jwt-secret-minimum-32-chars-long!"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# S3 Compatible Object Storage (Local MinIO / Development Placeholder)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="ca-career-os-resumes"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# AI Provider Configuration (Safe local mock default)
# Production values: openai | anthropic (requires live API key)
AI_PROVIDER="mock"
AI_MODEL="ca-intelligence-v1"
AI_API_KEY="mock-dev-key"

# Payment Gateway (Razorpay Sandbox Placeholders)
# In production, must be live merchant credentials (rzp_live_...). Sandbox keys will be rejected.
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="rzp_test_webhook_secret_hmac"

# Email Delivery Configuration (Central SMTP & Login OTP Delivery)
# Local development uses safe mock adapter (zero real emails sent).
# Production requires live SMTP provider credentials (e.g. AWS SES, Resend, Mailgun, Postmark).
EMAIL_PROVIDER="mock"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password-secret"
SMTP_FROM_EMAIL="noreply@cacareeros.com"
SMTP_FROM_NAME="CA Career OS"
APP_URL="http://localhost:3000"
PUBLIC_APP_ORIGIN="http://localhost:3000"

# Document Intelligence & OCR Configuration (Form 108 Verification - M-006 / F-038)
# Local development uses deterministic mock parser (isMock: true, 96% confidence).
# Production requires live cloud OCR service (AWS Textract, Google Cloud Vision, or Tesseract).
OCR_PROVIDER="mock"
OCR_CONFIDENCE_THRESHOLD=0.60
AWS_TEXTRACT_REGION="ap-south-1"
AWS_TEXTRACT_ACCESS_KEY_ID="placeholder-aws-key"
AWS_TEXTRACT_SECRET_ACCESS_KEY="placeholder-aws-secret"


