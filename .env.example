# ==============================================================================
# EZAPPLY — ENVIRONMENT TEMPLATE FOR DEPLOYMENT (VERCEL & RAILWAY)
# ==============================================================================

# 1. CORE APPLICATION & SECURITY (REQUIRED)
NODE_ENV=production
# Minimum 32-character random string for HMAC SHA-256 JWT signing
JWT_SECRET="generate-a-secure-random-32-char-string-for-production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# 2. POSTGRESQL DATABASE (REQUIRED FOR PERSISTENCE ON RAILWAY)
# Get free PostgreSQL from Supabase (supabase.com) or Neon (neon.tech)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]?schema=public"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]?schema=public"

# 3. AI INTELLIGENCE (REQUIRED FOR AI RESUME TAILORING & AI CAREER COPILOT)
# Get free API key from NVIDIA Build (build.nvidia.com) or Groq (console.groq.com)
AI_PROVIDER="nvidia"
AI_MODEL="meta/llama-3.3-70b-instruct"
AI_API_KEY="nvapi-your-nvidia-api-key"
NVIDIA_API_KEY="nvapi-your-nvidia-api-key"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# Groq Fast Fallback LLM (Optional fallback)
GROQ_API_KEY="gsk_your-groq-api-key"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="openai/gpt-oss-120b"

# 4. SMTP EMAIL & REAL-TIME SCRAPING ALERTS (REQUIRED FOR EMAIL NOTIFICATIONS)
# Use Gmail with a 16-character Google App Password (myaccount.google.com/apppasswords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_FROM_EMAIL="your-email@gmail.com"
SMTP_FROM_NAME="EZapply Alerts"
ADMIN_NOTIFICATION_EMAIL="your-email@gmail.com"

# 5. VERCEL REVERSE PROXY (REQUIRED ON VERCEL IF BACKEND IS HOSTED ON RAILWAY)
# Set this in Vercel Project Settings > Environment Variables:
# API_ORIGIN="https://your-api.up.railway.app"
